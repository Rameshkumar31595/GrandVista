        {
          "name": "Malformed token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer abc.def.ghi"
              }
            ],
            "url": "{{baseUrl}}/bookings/my"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Invalid token message\", () => pm.expect(pm.response.json().message).to.eql(\"JWT token is invalid or malformed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tampered token - role changed to ADMIN (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tamperedToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Take the real user token, change ROLE_USER -> ROLE_ADMIN in the payload, keep the old signature.",
                  "const [h, p, s] = pm.environment.get('userToken').split('.');",
                  "const json = atob(p.replace(/-/g, '+').replace(/_/g, '/')).replace('ROLE_USER', 'ROLE_ADMIN');",
                  "const forged = btoa(json).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.variables.set('tamperedToken', h + '.' + forged + '.' + s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
