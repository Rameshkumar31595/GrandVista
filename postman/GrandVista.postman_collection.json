    {
      "name": "4. Bookings",
      "item": [
        {
          "name": "Create booking (PENDING, saves bookingId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"numberOfGuests\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const b = pm.response.json();",
                  "pm.environment.set('bookingId', b.bookingId);",
                  "pm.test(\"PENDING with server-side price\", () => { pm.expect(b.bookingStatus).to.eql(\"PENDING\"); pm.expect(b.totalAmount).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay booking - success (Booking -> Payment -> Room)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"UPI\",\n  \"simulateFailure\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const o = pm.response.json();",
                  "pm.environment.set('paymentId', o.booking.paymentId);",
                  "pm.test(\"Booking CONFIRMED\", () => pm.expect(o.booking.bookingStatus).to.eql(\"CONFIRMED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Overlapping booking for same room (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"checkIn\": \"{{overlapCheckIn}}\",\n  \"checkOut\": \"{{overlapCheckOut}}\",\n  \"numberOfGuests\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Collision message\", () => pm.expect(pm.response.json().message).to.include(\"already reserved\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Adjacent booking - check-in on previous check-out day (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"checkIn\": \"{{checkOut}}\",\n  \"checkOut\": \"{{adjacentCheckOut}}\",\n  \"numberOfGuests\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set('bookingId2', pm.response.json().bookingId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay booking - simulated failure (CANCELLED, room released)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId2}}/pay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CARD\",\n  \"simulateFailure\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const o = pm.response.json();",
                  "pm.test(\"Payment FAILED\", () => pm.expect(o.paymentStatus).to.eql(\"FAILED\"));",
                  "pm.test(\"Booking CANCELLED\", () => pm.expect(o.booking.bookingStatus).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid date range (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"checkIn\": \"{{checkOut}}\",\n  \"checkOut\": \"{{checkIn}}\",\n  \"numberOfGuests\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
