{
  "info": {
    "name": "GrandVista Hospitality",
    "description": "Review-1 demonstration requests. All calls go through the API Gateway ({{baseUrl}}).\nRun folders in order: 1 Auth -> 2 Rooms -> 3 Admin -> 4 Bookings -> 5 Payments -> 6 Security demos.\nSet adminPassword in the environment first (same value as ADMIN_PASSWORD in grandvista-local.properties).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Stay dates relative to today so the collection works on any day.",
          "const day = (offset) => { const d = new Date(); d.setDate(d.getDate() + offset); return d.toISOString().slice(0, 10); };",
          "pm.collectionVariables.set('checkIn', day(30));",
          "pm.collectionVariables.set('checkOut', day(33));",
          "pm.collectionVariables.set('overlapCheckIn', day(32));",
          "pm.collectionVariables.set('overlapCheckOut', day(35));",
          "pm.collectionVariables.set('adjacentCheckOut', day(35));",
          "pm.collectionVariables.set('refundCheckIn', day(40));",
          "pm.collectionVariables.set('refundCheckOut', day(42));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    },
    {
      "key": "overlapCheckIn",
      "value": ""
    },
    {
      "key": "overlapCheckOut",
      "value": ""
    },
    {
      "key": "adjacentCheckOut",
      "value": ""
    },
    {
      "key": "refundCheckIn",
      "value": ""
    },
    {
      "key": "refundCheckOut",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Reddy\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('userEmail', 'asha.' + Date.now() + '@example.com');",
                  "if (!pm.environment.get('userPassword')) pm.environment.set('userPassword', 'Secret123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"New account is ROLE_USER\", () => pm.expect(pm.response.json().role).to.eql(\"ROLE_USER\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with injected ADMIN role (still ROLE_USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mallory\",\n  \"email\": \"mallory.{{$timestamp}}@example.com\",\n  \"password\": \"Secret123\",\n  \"role\": \"ROLE_ADMIN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Role cannot be chosen by the client\", () => pm.expect(pm.response.json().role).to.eql(\"ROLE_USER\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register invalid data (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Field errors returned\", () => pm.expect(pm.response.json().validationErrors).to.have.property(\"email\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user (saves userToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.environment.set('userToken', body.accessToken);",
                  "pm.environment.set('userId', body.user.id);",
                  "pm.test(\"Bearer token issued\", () => pm.expect(body.tokenType).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"WrongPassword1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Generic message\", () => pm.expect(pm.response.json().message).to.eql(\"Invalid email or password\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (saves adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.environment.set('adminToken', pm.response.json().accessToken);",
                  "pm.test(\"Admin role\", () => pm.expect(pm.response.json().user.role).to.eql(\"ROLE_ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
