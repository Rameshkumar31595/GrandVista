# Configuration for `docker compose` (copy to ".env", which is git-ignored, and fill in the blanks).
# This file contains NO real secrets. Native (non-Docker) development uses grandvista-local.properties instead.

# ---- PostgreSQL container (a new, empty server - not the PostgreSQL installed on your machine) ----
DB_USERNAME=grandvista
DB_PASSWORD=

# ---- JWT: Base64 key of AT LEAST 32 random bytes, shared by the auth service, the gateway and the services ----
#   bash:        openssl rand -base64 48
#   PowerShell:  $b=[byte[]]::new(48); [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ---- service-to-service key (booking -> room/payment internal endpoints): any long random string ----
INTERNAL_API_KEY=

# ---- demonstration administrator, created on first start if no administrator exists ----
ADMIN_NAME=GrandVista Administrator
ADMIN_EMAIL=admin@grandvista.com
ADMIN_PASSWORD=

# ---- review demo login (OPT-IN, default off) ----
# true = the login page offers passwordless "Demo Login" for 3 fixed demo accounts (2 guests, 1 administrator).
# Use only for local / academic demonstrations. Leave false (or unset) for anything else. Only auth-service reads it,
# so `docker compose up -d auth-service` applies a change without rebuilding images.
DEMO_MODE_ENABLED=false
DEMO_GUEST1_NAME=Ramesh
DEMO_GUEST2_NAME=Demo Guest 2
DEMO_MANAGER_NAME=GrandVista Manager

# ---- OPTIONAL shared mode: Docker services use the PostgreSQL installed on Windows (port 5433) ----
# Only read when you start with:  -f docker-compose.yml -f docker-compose.shared-db.yml   (see SHARED_DATABASE_CONFIGURATION_REPORT.md)
# SHARED_DB_USERNAME=
# SHARED_DB_PASSWORD=
# SHARED_DB_PORT=5433

# ---- optional tuning ----
HOLD_MINUTES=15
SEED_DEMO_DATA=true
PAYMENT_MAX_AMOUNT=500000

# ---- browser-facing URLs (change only when serving the UI/gateway from another host name) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
